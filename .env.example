# Copy this file to `.env` and adjust as needed. `.env` is gitignored.
# All values below are the defaults baked into backend/config.py unless
# marked otherwise; every field can be overridden here.

# Base URL of the api.star-citizen.wiki commodities/prices API.
WIKI_API_BASE_URL=https://api.star-citizen.wiki/api

# Base URL of the UEX Corp public API (terminals / terminals_distances
# endpoints). Verified empirically (Task 3): use api.uexcorp.uk, NOT
# uexcorp.space/api/2.0 -- the latter fronts the same API but has
# Cloudflare bot-management that blocks Python httpx clients even with
# full browser-like headers (this is a TLS/HTTP fingerprint block, not a
# UA-string check). api.uexcorp.uk serves the identical dataset with no
# such block. See backend/clients/uex_client.py's module docstring.
UEX_API_BASE_URL=https://api.uexcorp.uk/2.0

# Optional UEX Corp API key (Bearer token), only needed if UEX later locks
# down terminals/terminals_distances -- as of Task 3 both are confirmed
# public/anonymous (no auth wall, no lock icon in UEX's own docs). Leave
# blank for anonymous/public access.
UEX_API_KEY=

# Optional shared-secret required in the X-Refresh-Token header to call
# POST /refresh. Leave blank to disable the check (local dev default) --
# must be set before this app is ever exposed off localhost.
REFRESH_TOKEN=

# Default max distance (in-game units) a trade edge search considers when
# the client doesn't specify one.
DISTANCE_THRESHOLD_DEFAULT=20000.0

# Server-side cap on distance_threshold regardless of client input.
DISTANCE_THRESHOLD_MAX=100000.0

# Server-side cap on the total route search distance budget (max_distance).
MAX_DISTANCE_CAP=500000.0

# Minimum distance floor used to avoid divide-by-zero on same-station
# (near-zero in-game distance) terminal pairs.
MIN_DISTANCE_FLOOR=1.0

# Filesystem path to the local SQLite cache database.
DB_PATH=./data/cache.db

# Exact origin allowed by CORS (the Streamlit frontend's URL). Never "*".
CORS_ALLOWED_ORIGIN=http://localhost:8501

# slowapi-style rate limit applied to endpoints without a more specific limit.
RATE_LIMIT_DEFAULT=60/minute

# Tighter slowapi-style rate limit for POST /refresh (triggers outbound
# calls to two external APIs and rewrites the cache).
RATE_LIMIT_REFRESH=5/minute

# slowapi-style rate limit for POST /route (runs a graph search).
RATE_LIMIT_ROUTE=20/minute

# Timeout (seconds) applied to every outbound httpx call (wiki + UEX clients).
HTTP_TIMEOUT_SECONDS=10.0

# Max retry attempts for outbound httpx calls (wiki + UEX clients).
HTTP_MAX_RETRIES=3

# Edge-count threshold above which a graph build logs a density warning
# (surfaced via /refresh-status) instead of failing silently.
GRAPH_EDGE_COUNT_GUARDRAIL=50000

# Max number of labels retained per node during route search (dominance
# pruning safety valve against combinatorial blowup on dense graphs).
SEARCH_LABEL_CAP_PER_NODE=50

# Wall-clock budget (seconds) for a single /route search before returning
# the best label found so far (anytime behavior).
SEARCH_TIME_BUDGET_SECONDS=2.0
